{
  "name": "nuy-laundry-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Nuy Laundry Frontend Monorepo (Nuxt 3 Customer & React Vite Admin)",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:customer": "pnpm --filter web-customer dev",
    "dev:admin": "pnpm --filter admin-dashboard dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "packageManager": "pnpm@12.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": ["laundry", "nuxt", "react", "monorepo", "bwa", "clean-architecture"]
}
